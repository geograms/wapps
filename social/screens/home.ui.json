[
  {
    "$": "screen",
    "name": "Activity",
    "icon": "home",
    "tip": "Notes from the accounts you follow. Share an update below.",
    "children": [
      {
        "$": "field",
        "name": "activity",
        "$type": "chat",
        "hint": "What's happening?"
      },
      {
        "$": "action",
        "name": "clear_feed",
        "label": "Clear feed",
        "icon": "delete",
        "slot": "menu",
        "tip": "Remove all posts currently in the feed"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Follows",
    "icon": "people",
    "tip": "Accounts you follow appear in your Activity feed.",
    "children": [
      {
        "$": "action",
        "name": "follow_add",
        "label": "Follow an npub",
        "icon": "person_add",
        "style": "primary",
        "tip": "Paste an npub or hex pubkey to follow — their notes appear in Activity."
      },
      {
        "$": "field",
        "name": "follow_input",
        "$type": "string",
        "label": "npub / hex pubkey",
        "hint": "npub1…",
        "slot": "menu"
      },
      {
        "$": "field",
        "name": "follows_list",
        "$type": "people",
        "tip": "Who you follow; tap a row to unfollow."
      }
    ]
  },
  {
    "$": "screen",
    "name": "Search",
    "icon": "search",
    "menu": true,
    "tip": "Find posts and people across your feed and the connected relays.",
    "children": [
      {
        "$": "field",
        "name": "search_input",
        "$type": "string",
        "label": "Search",
        "hint": "Words, #topic, or a name"
      },
      {
        "$": "action",
        "name": "search_go",
        "label": "Search",
        "icon": "search",
        "style": "primary"
      },
      {
        "$": "field",
        "name": "search_results",
        "$type": "chat"
      }
    ]
  },
  {
    "$": "screen",
    "name": "Relay servers",
    "icon": "cloud",
    "menu": true,
    "tip": "Relays this device talks to — internet (wss://), Reticulum (rns://) or this device (local)",
    "children": [
      {
        "$": "field",
        "name": "relays",
        "$type": "people",
        "tip": "Tap a relay to remove it. Status shows reachability."
      },
      {
        "$": "field",
        "name": "new_relay",
        "$type": "string",
        "label": "Add a relay",
        "hint": "wss://relay.example.com  |  rns://<id>  |  local"
      },
      {
        "$": "action",
        "name": "relay_add",
        "label": "Add relay",
        "icon": "add",
        "style": "primary"
      }
    ]
  }
]
