[
  {
    "$": "screen",
    "name": "@screen.store",
    "tip": "@screen.store_tip",
    "children": [
      {
        "$": "group",
        "$type": "header-actions",
        "children": [
          {
            "$": "group",
            "$type": "menu",
            "icon": "apps",
            "tip": "View",
            "children": [
              { "$": "action", "name": "view-list", "label": "List view" },
              { "$": "action", "name": "view-grid", "label": "Grid view" }
            ]
          }
        ]
      },
      {
        "$": "group",
        "name": "catalog",
        "$type": "cards",
        "layout": "list",
        "empty": "No wapps found yet. Add a repository in Settings."
      }
    ]
  },
  {
    "$": "screen",
    "name": "@screen.settings",
    "tip": "@screen.settings_tip",
    "children": [
      {
        "$": "group",
        "name": "@group.sources_name",
        "$type": "sources",
        "tip": "@group.sources_tip"
      }
    ]
  }
]
